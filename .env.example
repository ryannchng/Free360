# Copy to .env in the project root. These are public app credentials, not secrets.
# Choose one backend for this app build.
# For the independent Docker server, use EXPO_PUBLIC_BACKEND=self-hosted and
# EXPO_PUBLIC_SELF_HOSTED_URL=https://group.example.com; the Supabase values below are unused.
# See docker/README.md.
EXPO_PUBLIC_BACKEND=supabase
EXPO_PUBLIC_SELF_HOSTED_URL=
# For managed Supabase, find both values in your project's Connect / API settings.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
